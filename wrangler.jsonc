{
  // RegaDRIVE — isolated Worker. Shares NO resources with Rega24 or R&L.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regadrive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Owner-authorised production domain. Cloudflare refuses the attach unless the zone is in this account.
  "routes": [{ "pattern": "www.regaplatform.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Workers AI (free daily allocation). Used only when AI is enabled and the gateway's free-only guard passes.
  "ai": { "binding": "AI" },
  // D1 `regadrive-db` (owner-approved 2026-11-07) is used ONLY by the /dr owner control center (dr_* tables,
  // migrations/0003_dr_admin.sql). No student record is ever written there.
  // D1 `regadrive-students` (owner-approved 2026-11-11) holds ONLY student accounts (migrations-students/).
  // The content/payments production database stays OFF (DATABASE_PRODUCTION_ENABLED=false).
  "d1_databases": [
    { "binding": "DB", "database_name": "regadrive-db", "database_id": "bd9f0f57-3b67-49ab-9597-f8ce9b305c88", "migrations_dir": "migrations" },
    { "binding": "STUDENT_DB", "database_name": "regadrive-students", "database_id": "4b6065a1-812c-44c3-8558-b50e66e18764", "migrations_dir": "migrations-students" }
  ],
  "vars": {
    "APP_ENV": "production",
    "CONTENT_MODE": "production",
    "PAYMENTS_ENABLED": "false",
    "CHECKOUT_ENABLED": "false",
    "LIVE_PAYMENT_WEBHOOKS_ENABLED": "false",
    "PURCHASE_REQUIRED": "false",
    "DATABASE_PRODUCTION_ENABLED": "false",
    "LICENSE_ENFORCEMENT_ENABLED": "false",
    "OFFICIAL_QUESTION_BANK_ENABLED": "false",
    "CONTENT_ADMIN_ENABLED": "false",
    "CONTENT_IMPORT_EXECUTION_ENABLED": "false",
    "PUBLIC_OFFICIAL_MOCK_EXAMS_ENABLED": "false",
    "CONTENT_AUTO_SYNC_ENABLED": "false",
    "SUBSCRIPTIONS_ENABLED": "false",
    // Student e-mail registration / sign-in (owner-approved 2026-11-11). /dr can switch it off at any time.
    "STUDENT_AUTH_ENABLED": "true",
    "STUDENT_MAIL_FROM": "RegaDRIVE <no-reply@regaplatform.com>",
    "AI_ENABLED": "true",
    "AI_FREE_ONLY": "true",
    "AI_PAID_FALLBACK_ENABLED": "false",
    "AI_PROVIDER_ORDER": "gemini,groq,openrouter,workers-ai",
    "AI_MAX_RETRIES_PER_PROVIDER": "1",
    "AI_DAILY_COST_LIMIT_EUR": "0",
    "AI_DOMAIN_SCOPE": "regadrive",
    "LIFETIME_PRICE_EUR": "20",
    // /dr: the only address that can receive a sign-in code (owner decision 2026-11-07), and the verified sender.
    "DR_OWNER_EMAIL": "regaplatform1@gmail.com",
    "DR_MAIL_FROM": "RegaDRIVE <security@regaplatform.com>"
  },
  "observability": { "enabled": true }
}
